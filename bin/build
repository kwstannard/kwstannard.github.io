#! /usr/bin/env ruby

ARGV.concat Dir['src/*'] if ARGV.empty?

require 'bundler/inline'

gemfile do
  source 'https://rubygems.org'
  gem 'irb'
  gem 'slim'
  gem 'kramdown'
  gem 'kramdown-parser-gfm'
  gem 'rake'
end

Slim::Embedded.options[:markdown] = { input: "GFM" }

extend Rake::DSL
files = Rake::FileList.new("src/*.md").ext(".html")
files += Rake::FileList.new("src/*.slim").ext

task html: files.pathmap("%f")

rule ".html" => [proc { it.pathmap("src/%f").ext('md') }, "post.html.slim"] do |task|
  puts task.name + " " + task.source
  @body = Kramdown::Document.new(File.read(task.source), input: 'GFM', hard_wrap: false).to_html
  t = Slim::Template.new("post.html.slim")
  File.write(task.name, t.render { @body })
end

rule ".html" => [proc { it.pathmap("src/%f.slim") }, "post.html.slim"] do |task|
  puts task.name + " " + task.source
  body = Slim::Template.new(task.source).render
  t = Slim::Template.new("post.html.slim")
  File.write(task.name, t.render { body })
end

Rake::Task['html'].invoke(verbose: true)
